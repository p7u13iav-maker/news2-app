# === RSS feeds ===
# The news page uses public RSS feeds and requires no API key.

# === OITOMA AI (Okayama University, local LLM) ===
# Docs: https://ironical.okayama-u.ac.jp/ai/explanation
# Get your API key: https://ironical.okayama-u.ac.jp/ai/keys (campus login required)
#
# OITOMA_BASE_URL defaults to https://ironical.okayama-u.ac.jp/ai/v1
# OITOMA_MODEL defaults to qwen3.8-27b-it (think) — use qwen3.6-35b-a3b-it for fast
#
# Copy this file to .env.local and fill in your real key:
OITOMA_API_KEY=sk-your-key-here
